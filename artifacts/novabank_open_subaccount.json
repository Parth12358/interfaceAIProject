{
  "schema_version": "1.0",
  "capability": {
    "id": "novabank_open_subaccount",
    "version": "1.0.0",
    "status": "approved",
    "description": "Look up a member and open a new High-Yield Savings sub-account through the multi-field form, reaching the confirmation screen.",
    "app": {
      "id": "novabank",
      "entry": "http://127.0.0.1:5055/novabank/",
      "launch": "browser-app-mode",
      "viewport": [1280, 800]
    },
    "inputs": {
      "member_id": { "type": "string", "pattern": "^[0-9]{5}$", "description": "5-digit member ID" },
      "nickname": { "type": "string", "pattern": "^.{1,40}$", "description": "Nickname for the new sub-account" },
      "deposit": { "type": "string", "pattern": "^\\$?[0-9][0-9,]*(\\.[0-9]{2})?$", "description": "Initial deposit (>= product minimum)" }
    },
    "outputs": {
      "member_name": { "type": "string", "extract": "step:read_name", "description": "Account holder name" },
      "savings_balance": { "type": "string", "extract": "step:read_savings", "description": "Existing savings balance" },
      "account_number": { "type": "string", "extract": "step:read_account_number", "description": "New sub-account number" }
    }
  },
  "steps": [
    {
      "id": "open_lookup",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "Find a Member", "role_hint": "button", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["member_lookup"], "timeout_ms": 8000 }
    },
    {
      "id": "enter_id",
      "action": { "kind": "type", "value": "{member_id}" },
      "target": { "text_anchor": { "text": "Member ID", "relation": "below", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["member_lookup"], "timeout_ms": 5000 }
    },
    {
      "id": "submit_search",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "Search", "role_hint": "button", "fuzzy_min": 0.85 } },
      "expect": {
        "any_of": ["member_detail", "no_member_found", "validation_error",
                   "permission_denied", "arrears", "compliance_hold", "app_error"],
        "timeout_ms": 10000
      }
    },
    {
      "id": "read_name",
      "action": { "kind": "read" },
      "target": { "text_anchor": { "text": "Member Name", "relation": "right_of", "max_px": 800, "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["member_detail"], "timeout_ms": 4000 },
      "extract_as": "member_name"
    },
    {
      "id": "read_savings",
      "action": { "kind": "read" },
      "target": { "text_anchor": { "text": "Savings Balance", "relation": "right_of", "max_px": 800, "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["member_detail"], "timeout_ms": 4000 },
      "extract_as": "savings_balance"
    },
    {
      "id": "open_form",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "Open Sub-Account", "role_hint": "button", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["subaccount_form"], "timeout_ms": 8000 }
    },
    {
      "id": "choose_product",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "High-Yield Savings", "role_hint": "radio", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["subaccount_form"], "timeout_ms": 4000 }
    },
    {
      "id": "enter_nickname",
      "action": { "kind": "type", "value": "{nickname}" },
      "target": { "text_anchor": { "text": "Account Nickname", "relation": "below", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["subaccount_form"], "timeout_ms": 5000 }
    },
    {
      "id": "enter_deposit",
      "action": { "kind": "type", "value": "{deposit}" },
      "target": { "text_anchor": { "text": "Initial Deposit", "relation": "below", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["subaccount_form"], "timeout_ms": 5000 }
    },
    {
      "id": "accept_terms",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "I agree to the account terms", "role_hint": "checkbox", "fuzzy_min": 0.80 } },
      "expect": { "any_of": ["subaccount_form"], "timeout_ms": 4000 }
    },
    {
      "id": "review",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "Review Account", "role_hint": "button", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["account_review", "form_validation"], "timeout_ms": 8000 }
    },
    {
      "id": "confirm",
      "action": { "kind": "click" },
      "target": { "text_anchor": { "text": "Confirm Opening", "role_hint": "button", "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["account_opened"], "timeout_ms": 8000 }
    },
    {
      "id": "read_account_number",
      "action": { "kind": "read" },
      "target": { "text_anchor": { "text": "New Account Number", "relation": "right_of", "max_px": 800, "fuzzy_min": 0.85 } },
      "expect": { "any_of": ["account_opened"], "timeout_ms": 4000 },
      "extract_as": "account_number"
    }
  ],
  "screen_states": {
    "app_ready": { "all_of": [{ "text": "NovaBank" }], "class": "precondition" },
    "member_lookup": { "all_of": [{ "text": "Member lookup" }], "class": "progress" },
    "member_detail": { "all_of": [{ "text": "Member relationship" }], "class": "progress" },
    "subaccount_form": { "all_of": [{ "text": "Open a new sub-account" }], "class": "progress" },
    "account_review": { "all_of": [{ "text": "Account review" }], "class": "progress" },
    "account_opened": { "all_of": [{ "text": "Sub-account confirmation" }], "class": "progress" },
    "no_member_found": { "all_of": [{ "text": "No member found" }], "class": "business_outcome", "outcome_code": "MEMBER_NOT_FOUND" },
    "validation_error": { "all_of": [{ "text": "Invalid member number" }], "class": "business_outcome", "outcome_code": "INVALID_INPUT" },
    "permission_denied": { "all_of": [{ "text": "Access denied" }], "class": "business_outcome", "outcome_code": "ACCESS_DENIED" },
    "arrears": { "all_of": [{ "text": "Account in arrears" }], "class": "business_outcome", "outcome_code": "ACCOUNT_IN_ARREARS" },
    "form_validation": { "all_of": [{ "text": "Please correct the following" }], "class": "business_outcome", "outcome_code": "INVALID_FORM" },
    "app_error": { "all_of": [{ "text": "System error" }], "class": "failure", "error_code": "APP_ERROR_500" },
    "compliance_hold": { "all_of": [{ "text": "Compliance hold" }], "class": "failure", "error_code": "COMPLIANCE_HOLD" },
    "slow_load": {
      "all_of": [{ "text": "Processing request" }], "class": "recoverable",
      "recovery": { "kind": "wait", "ms": 1500, "max_attempts": 4, "then": "retry_step" }
    },
    "session_timeout": {
      "all_of": [{ "text": "Session expired" }], "class": "recoverable",
      "recovery": { "kind": "click", "target": { "text_anchor": { "text": "Continue" } }, "max_attempts": 1, "then": "retry_step" }
    }
  },
  "provenance": {
    "discovered_at": "hand-authored",
    "model": "none",
    "platform": "cross-platform",
    "surface": "cdp",
    "discovery_run": "n/a — multi-field form + review/confirmation flow"
  }
}
