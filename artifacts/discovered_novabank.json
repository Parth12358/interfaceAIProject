{
  "schema_version": "1.0",
  "capability": {
    "id": "discovered_novabank",
    "version": "1.0.0",
    "status": "draft",
    "description": "Look up member {member_id} and read their name, account status and savings balance",
    "app": {
      "id": "novabank",
      "entry": "http:/127.0.0.1:5055/novabank/",
      "launch": "browser-app-mode",
      "viewport": [
        1280,
        800
      ]
    },
    "inputs": {
      "member_id": {
        "type": "string",
        "pattern": "^[0-9]{5}$",
        "description": "member_id (parameterized from discovery)"
      }
    },
    "outputs": {
      "member_name": {
        "type": "string",
        "extract": "step:step_9_read"
      },
      "account_status": {
        "type": "string",
        "extract": "step:step_6_read"
      }
    }
  },
