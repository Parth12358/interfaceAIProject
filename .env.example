# LLM provider (discovery only). DeepSeek V4.1 Flash via its OpenAI-compatible API.
DEEPSEEK_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Target app
TARGET_APP_URL=http://127.0.0.1:5000/
TARGET_APP_PORT=5000

# Fault injection (reproducible evidence): set to 1 to arm the random session-timeout interstitial
CORESERV_INJECT_TIMEOUT=0

# Surface selection for replay/discovery: cdp (primary) | os (secondary)
SURFACE=cdp

# Chromium
CHROME_REMOTE_DEBUG_PORT=9222
VIEWPORT_W=1280
VIEWPORT_H=800
